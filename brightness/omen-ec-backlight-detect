#!/usr/bin/env python3
"""Find the EC backlight registers (ECPW, ECOE) and the suspend flag (PECF) in the firmware of an HP OMEN MAX 16.

Reads the DSDT (default /sys/firmware/acpi/tables/DSDT, needs root), decompiles it with
`iasl -d` (package acpica-tools) in a private temp dir, and walks the ACPI Field list of the
OperationRegion that contains ECPW to compute exact addresses. Nothing is hardcoded.

Prints a shell-sourceable config to stdout; --write PATH stores it instead (atomically).
Any ambiguity -> non-zero exit, explanation on stderr, nothing written.
Standard library only.
"""
import argparse
import datetime
import os
import re
import shutil
import subprocess
import sys
import tempfile

DEFAULT_DSDT = "/sys/firmware/acpi/tables/DSDT"
TESTED_BOARD = "8D41"


class DetectError(Exception):
    pass


def strip_comments(text):
    text = re.sub(r"/\*.*?\*/", " ", text, flags=re.S)
    return re.sub(r"//[^\n]*", "", text)


def parse_int(tok):
    tok = tok.strip()
    if re.fullmatch(r"0[xX][0-9a-fA-F]+", tok):
        return int(tok, 16)
    if re.fullmatch(r"[0-9]+", tok):
        return int(tok)
    raise DetectError("not a literal integer: %r" % tok)


_ENTRY = re.compile(
    r"""(?P<offset>Offset\s*\(\s*(?P<off>[^)]*?)\s*\)\s*,?)
      | (?P<skip>(?:AccessAs|Connection)\s*\((?:[^()]|\([^()]*\))*\)\s*,?)
      | (?P<field>(?P<name>[A-Za-z_][A-Za-z0-9_]{0,3})?\s*,\s*(?P<bits>0[xX][0-9a-fA-F]+|[0-9]+)\s*(?:,|(?=\s*$)))
    """, re.X | re.S)


def walk_fields(body):
    """Yield (name_or_None, bit_offset, bits) for every entry of a Field body."""
    pos = 0
    bit = 0
    while True:
        while pos < len(body) and body[pos].isspace():
            pos += 1
        if pos >= len(body):
            return
        m = _ENTRY.match(body, pos)
        if not m:
            raise DetectError("cannot parse field list near %r" % body[pos:pos + 40])
        pos = m.end()
        if m.group("offset"):
            new = parse_int(m.group("off")) * 8
            if new < bit:
                raise DetectError("Offset goes backwards in field list")
            bit = new
        elif m.group("field"):
            bits = parse_int(m.group("bits"))
            if m.group("name"):
                yield m.group("name"), bit, bits
            bit += bits


def scan(dsl, names):
    """Return ({name: [(region, bit, bits), ...]}, {region: [(space, base, len), ...]})."""
    text = strip_comments(dsl)
    regions = {}
    for m in re.finditer(r"OperationRegion\s*\(\s*(\w+)\s*,\s*(\w+)\s*,\s*([^,]+?)\s*,\s*([^)]+?)\s*\)", text):
        regions.setdefault(m.group(1), []).append((m.group(2), m.group(3), m.group(4)))
    found = {n: [] for n in names}
    for m in re.finditer(r"\bField\s*\(\s*(\w+)\s*,[^)]*\)\s*\{", text):
        start = m.end()
        end = text.find("}", start)
        if end < 0:
            raise DetectError("unterminated Field block")
        for name, bit, bits in walk_fields(text[start:end]):
            if name in found:
                found[name].append((m.group(1), bit, bits))
    return found, regions


def locate(found, regions, name):
    """Resolve one field to (region, byte address, bit within byte, bits)."""
    if not found[name]:
        raise DetectError("no field named %s found in any Field block (different firmware?)" % name)
    if len(found[name]) > 1:
        raise DetectError("%s is defined %d times; refusing to guess" % (name, len(found[name])))
    reg, bit, bits = found[name][0]
    if reg not in regions or len(regions[reg]) != 1:
        raise DetectError("region %s not defined exactly once" % reg)
    space, base_tok, len_tok = regions[reg][0]
    if space != "SystemMemory":
        raise DetectError("region %s is %s, not SystemMemory" % (reg, space))
    try:
        base, length = parse_int(base_tok), parse_int(len_tok)
    except DetectError as e:
        raise DetectError("region %s base/length: %s" % (reg, e))
    if bit // 8 >= length:
        raise DetectError("%s lies outside region %s" % (name, reg))
    return reg, base + bit // 8, bit % 8, bits


def find_registers(dsl):
    """Backlight registers: dict with region name and addresses of ECPW and ECOE."""
    found, regions = scan(dsl, ("ECPW", "ECOE"))
    reg, pw_addr, pw_bit, pw_bits = locate(found, regions, "ECPW")
    reg2, oe_addr, oe_bit, oe_bits = locate(found, regions, "ECOE")
    if reg != reg2:
        raise DetectError("ECPW is in region %s but ECOE in %s" % (reg, reg2))
    if pw_bits != 8 or pw_bit:
        raise DetectError("ECPW is %d bits at bit %d of its byte, expected 8 bits byte-aligned" % (pw_bits, pw_bit))
    if oe_bits != 1:
        raise DetectError("ECOE is %d bits, expected 1" % oe_bits)
    return {"region": reg, "ecpw_addr": pw_addr, "ecoe_addr": oe_addr, "ecoe_bit": oe_bit}


def find_pecf(dsl):
    """Suspend flag: dict with address and bit of PECF (1 bit, SystemMemory region)."""
    found, regions = scan(dsl, ("PECF",))
    reg, addr, bit, bits = locate(found, regions, "PECF")
    if bits != 1:
        raise DetectError("PECF is %d bits, expected 1" % bits)
    return {"pecf_region": reg, "pecf_addr": addr, "pecf_bit": bit}


def read_dmi(name):
    try:
        with open("/sys/class/dmi/id/" + name) as f:
            return f.read().strip()
    except OSError:
        return ""


def decompile(dsdt_path):
    iasl = shutil.which("iasl")
    if not iasl:
        raise DetectError("iasl not found; install it (Debian/Ubuntu: apt install acpica-tools)")
    with tempfile.TemporaryDirectory(prefix="omen-ec-") as tmp:
        src = os.path.join(tmp, "DSDT")
        try:
            shutil.copyfile(dsdt_path, src)
        except OSError as e:
            raise DetectError("cannot read %s: %s (run as root?)" % (dsdt_path, e))
        subprocess.run([iasl, "-d", src], cwd=tmp, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, check=False)
        out = os.path.join(tmp, "DSDT.dsl")
        if not os.path.exists(out):
            raise DetectError("iasl could not decompile %s" % dsdt_path)
        with open(out, encoding="utf-8", errors="replace") as f:
            return f.read()


def render_config(regs, board, bios, date, pecf=None):
    cfg = (
        "# Generated by omen-ec-backlight-detect; re-run after a BIOS update.\n"
        "ECPW_ADDR=0x%08X\n"
        "ECOE_ADDR=0x%08X\n"
        "ECOE_BIT=%d\n" % (regs["ecpw_addr"], regs["ecoe_addr"], regs["ecoe_bit"]))
    if pecf:
        cfg += "PECF_ADDR=0x%08X\nPECF_BIT=%d\n" % (pecf["pecf_addr"], pecf["pecf_bit"])
    return cfg + "BOARD_NAME=%s\nBIOS_VERSION=%s\nDETECTED=%s\n" % (board, bios, date)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    src = ap.add_mutually_exclusive_group()
    src.add_argument("--dsdt", metavar="FILE", help="raw DSDT file (default %s)" % DEFAULT_DSDT)
    src.add_argument("--dsl", metavar="FILE", help="already decompiled DSL file")
    ap.add_argument("--write", metavar="PATH", help="write the config to PATH instead of stdout")
    args = ap.parse_args(argv)
    try:
        if args.dsl:
            with open(args.dsl, encoding="utf-8", errors="replace") as f:
                dsl = f.read()
        else:
            dsl = decompile(args.dsdt or DEFAULT_DSDT)
        regs = find_registers(dsl)
        try:
            pecf = find_pecf(dsl)
        except DetectError as e:
            pecf = None
            print("WARNING: PECF not usable (%s). The brightness fix is unaffected, but the "
                  "suspend hook (keyboard/omen-ec-suspend.sleep) will stay inactive." % e,
                  file=sys.stderr)
    except (DetectError, OSError) as e:
        print("omen-ec-backlight-detect: %s" % e, file=sys.stderr)
        return 1

    board, bios = read_dmi("board_name"), read_dmi("bios_version")
    if board != TESTED_BOARD:
        print("WARNING: board is %r, this was only tested on %s. Untested here; "
              "verify the addresses by hand (docs/how-it-works.md)." % (board, TESTED_BOARD),
              file=sys.stderr)
    cfg = render_config(regs, board, bios, datetime.date.today().isoformat(), pecf)
    if args.write:
        tmp = args.write + ".new"
        with open(tmp, "w") as f:
            f.write(cfg)
        os.chmod(tmp, 0o644)
        os.replace(tmp, args.write)
        print("wrote %s" % args.write, file=sys.stderr)
    else:
        sys.stdout.write(cfg)
    return 0


if __name__ == "__main__":
    sys.exit(main())
